# =====================================================================
# Variáveis de ambiente do Agenda Barber
# Na Vercel: Settings > Environment Variables (copie nome e valor).
# NUNCA coloque este arquivo preenchido no GitHub. O arquivo .env já está no .gitignore.
# =====================================================================

# --- Obrigatórias ---------------------------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chave "anon" / "publishable"
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # chave "service_role" / "secret" (SECRETA)

# Endereço final do site, sem barra no fim (usado nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=https://agendabarber.com.br

# Seu e-mail de administrador (vê o painel /admin). Mais de um: separe por vírgula.
ADMIN_EMAILS=voce@exemplo.com

# Senha que protege a rota de lembretes. Invente uma longa e aleatória (32+ caracteres).
CRON_SECRET=troque-por-uma-senha-longa-e-aleatoria

# Segredo para assinar os códigos de verificação do WhatsApp. Outra senha longa e aleatória (32+ caracteres),
# diferente da de cima. Se trocar, os clientes precisam confirmar o número de novo.
BOOKING_SECRET=troque-por-outra-senha-longa-e-aleatoria

# (Opcional) Nome do sistema no rodapé da página de agendamento. Útil para vender para salões e manicures.
NEXT_PUBLIC_BRAND_NAME=Agenda Barber

# --- Plano e pagamento manual por Pix -------------------------------
PLAN_PRICE_BRL=49.90
PIX_KEY=sua-chave-pix
PIX_RECEIVER_NAME=Seu Nome ou Empresa
SUPPORT_WHATSAPP=5562999999999                  # só números, com 55 + DDD
SUPPORT_EMAIL=suporte@exemplo.com

# --- Cobrança automática (Asaas). Deixe em branco para usar só o Pix manual ---
ASAAS_API_KEY=
ASAAS_ENV=sandbox                               # troque para "production" quando for cobrar de verdade
ASAAS_WEBHOOK_TOKEN=                            # invente um token de 32+ caracteres e use o mesmo no Asaas

# --- WhatsApp automático (Meta). Deixe em branco para desligar ------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_TEMPLATE_CONFIRMATION=agendamento_confirmado_v2
WHATSAPP_TEMPLATE_REMINDER=lembrete_agendamento
WHATSAPP_TEMPLATE_DAY_BEFORE=lembrete_vespera
WHATSAPP_TEMPLATE_CODE=codigo_verificacao
